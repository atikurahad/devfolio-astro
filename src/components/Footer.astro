---
import { site } from '../data/site.ts';
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Left Column: Brand, Navigation, Socials -->
    <div class="footer-brand-wrap">
      <div class="footer-brand">
        <span class="footer-logo">{site.name}</span>
        <p class="footer-tagline">{site.headline}</p>
      </div>

      <nav class="footer-nav" aria-label="Footer Navigation">
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact</a>
      </nav>

      <div class="footer-socials">
        {site.socials.map((s) => (
          <a href={s.url || '#'} target="_blank" rel="noopener" class="social-pill">{s.label}</a>
        ))}
      </div>
    </div>

    <!-- Right Column: Nature & Sustainability Card -->
    <div class="footer-eco-card">
      <img
        src="/images/green-trees.png"
        alt="Lush green trees and soaring birds"
        class="eco-trees-img"
        width="316"
        height="159"
        loading="lazy"
      />
      <div class="eco-card-body">
        <span class="eco-pill">🌱 Save Carbon &bull; Conserve Water</span>
        <p class="eco-paragraph">
          Trees naturally absorb carbon dioxide, conserve fresh water, prevent soil erosion, and provide sanctuary for wildlife. Taking care of our green canopy ensures a living, sustainable world for everyone.
        </p>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <p class="footer-copy">
      &copy; {new Date().getFullYear()} {site.name} &mdash; Built with Astro
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 3.5rem 0 2rem;
    margin-top: 5rem;
  }

  .footer-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* Left Column */
  .footer-brand-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-logo {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.5;
    margin-top: 0.35rem;
    max-width: 420px;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .footer-nav a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    transition: color var(--transition);
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .social-pill {
    padding: 0.35rem 0.9rem;
    border-radius: 99px;
    border: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-secondary);
    transition: all var(--transition);
  }

  .social-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  /* Right Column: Eco Card */
  .footer-eco-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .footer-eco-card:hover {
    border-color: rgba(34, 197, 94, 0.3);
  }

  .eco-trees-img {
    max-width: 210px;
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 4px 12px rgba(16, 185, 129, 0.15));
  }

  .eco-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .eco-pill {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 0.25rem 0.7rem;
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.25);
    color: #4ade80;
  }

  [data-theme="light"] .eco-pill {
    background: rgba(22, 163, 74, 0.08);
    border-color: rgba(22, 163, 74, 0.2);
    color: #15803d;
  }

  .eco-paragraph {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Bottom Copyright */
  .footer-copy {
    font-size: 0.8rem;
    color: var(--muted);
    grid-column: 1 / -1;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
    text-align: center;
  }

  /* Responsive Breakpoints */
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .footer-eco-card {
      padding: 1.25rem 1.5rem;
    }

    .eco-trees-img {
      max-width: 180px;
    }
  }
</style>

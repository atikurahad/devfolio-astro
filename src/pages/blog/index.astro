---
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = [
  {
    title: 'Building Scalable REST APIs with Node.js and Express',
    date: 'Sep 20, 2026',
    excerpt: 'A deep dive into designing and building production-ready REST APIs with proper authentication, error handling, and architecture patterns.',
    tags: ['Node.js', 'Express', 'REST API'],
    slug: '#',
    readTime: '8 min read',
  },
  {
    title: 'TypeScript Best Practices for React Developers',
    date: 'Sep 10, 2026',
    excerpt: 'Explore the most impactful TypeScript patterns and tips to write safer, more maintainable React applications.',
    tags: ['TypeScript', 'React'],
    slug: '#',
    readTime: '6 min read',
  },
  {
    title: 'MongoDB Schema Design: Patterns and Anti-Patterns',
    date: 'Aug 28, 2026',
    excerpt: 'Understanding how to model your data in MongoDB for performance, flexibility, and real-world scale.',
    tags: ['MongoDB', 'Database'],
    slug: '#',
    readTime: '10 min read',
  },
  {
    title: 'Getting Started with Astro: The Island Architecture',
    date: 'Aug 15, 2026',
    excerpt: 'Astro brings a fresh approach to web development. Here is how its island architecture makes your sites faster.',
    tags: ['Astro', 'Web Dev'],
    slug: '#',
    readTime: '5 min read',
  },
];
---
<BaseLayout title="Blog" description="Articles on web development, JavaScript, TypeScript, and software engineering by Atikur Rahaman Ahad.">

  <section class="section" style="padding-top:calc(var(--header-h) + 3rem)">
    <div class="container" style="max-width:800px;">

      <p class="section-label fade-in">Blog</p>
      <h1 class="fade-in fade-in-delay-1" style="margin-bottom:0.75rem;">
        Thoughts on <span class="gradient-text">web engineering</span>
      </h1>
      <p class="fade-in fade-in-delay-2" style="margin-bottom:3rem;">
        Articles on JavaScript, TypeScript, backend architecture, and whatever I am exploring at the moment.
      </p>

      <div class="blog-grid">
        {posts.map((post, i) => (
          <article class={`card fade-in fade-in-delay-${(i % 3) + 1}`}>
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.5rem;">
              <span class="blog-card-date">{post.date}</span>
              <span style="font-size:0.75rem; color:var(--muted);">{post.readTime}</span>
            </div>
            <h2 class="blog-card-title">{post.title}</h2>
            <p class="blog-card-excerpt">{post.excerpt}</p>
            <div class="tags" style="margin-top:0.75rem; margin-bottom:0.75rem;">
              {post.tags.map(t => <span class="tag">{t}</span>)}
            </div>
            <a href={post.slug} class="blog-card-link">Read article &rarr;</a>
          </article>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

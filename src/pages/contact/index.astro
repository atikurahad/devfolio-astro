---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site.ts';
---
<BaseLayout title="Contact" description={`Get in touch with ${site.name} for freelance or full-time opportunities.`}>

  <section class="section" style="padding-top:calc(var(--header-h) + 3rem)">
    <div class="container">
      <div class="contact-grid">

        <!-- LEFT COLUMN: Contact Details & Socials -->
        <div class="fade-in">
          <span class="hero-badge" style="margin-bottom:1rem;">
            <span class="badge-dot"></span>
            Get in touch
          </span>
          <h1 style="margin-bottom:1rem;">Let&apos;s <span class="gradient-text">connect</span></h1>
          <p style="margin-bottom:2rem; line-height:1.8;">
            Whether you have a project idea, a job opportunity, or just want to discuss web development — my inbox is always open.
          </p>

          <div style="display:flex; flex-direction:column; gap:1.25rem; margin-bottom:2.5rem;">
            <!-- Email Card with Copy button -->
            <div class="card contact-info-card">
              <div style="display:flex; align-items:center; gap:1rem;">
                <div class="contact-card-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                </div>
                <div>
                  <p style="font-size:0.75rem; color:var(--muted); margin-bottom:2px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em;">Email</p>
                  <a href={`mailto:${site.contact.email || 'atikurahad.soft@gmail.com'}`} style="color:var(--text); font-weight:600; text-decoration:none; transition:color var(--transition);" class="email-link">
                    {site.contact.email || 'atikurahad.soft@gmail.com'}
                  </a>
                </div>
              </div>
              <button type="button" class="copy-btn" id="copy-email-btn" title="Copy email address" data-email={site.contact.email || 'atikurahad.soft@gmail.com'}>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                </svg>
                <span id="copy-text">Copy</span>
              </button>
            </div>

            <!-- Location Card -->
            <div class="card contact-info-card">
              <div style="display:flex; align-items:center; gap:1rem;">
                <div class="contact-card-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div>
                  <p style="font-size:0.75rem; color:var(--muted); margin-bottom:2px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em;">Location</p>
                  <p style="color:var(--text); font-weight:600;">{site.location}</p>
                </div>
              </div>
            </div>

            <!-- Status Card -->
            <div class="card contact-info-card">
              <div style="display:flex; align-items:center; gap:1rem;">
                <div class="contact-card-icon" style="background:var(--badge-bg); color:var(--badge-color); border-color:var(--badge-border);">
                  <span class="badge-dot" style="width:10px; height:10px;"></span>
                </div>
                <div>
                  <p style="font-size:0.75rem; color:var(--muted); margin-bottom:2px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em;">Availability</p>
                  <p style="color:var(--text); font-weight:600;">{site.availability}</p>
                </div>
              </div>
            </div>
          </div>

          <p class="section-label" style="margin-bottom:0.75rem;">Find me online</p>
          <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
            {site.socials.map(s => (
              <a href={s.url || '#'} target="_blank" rel="noopener noreferrer" class="social-pill">
                {s.label} &nearr;
              </a>
            ))}
          </div>
        </div>

        <!-- RIGHT COLUMN: Interactive Contact Form & Success Card -->
        <div class="fade-in fade-in-delay-2">
          <div class="contact-form-wrapper" id="form-wrapper">
            <!-- Confetti Canvas Overlay -->
            <canvas id="confetti-canvas"></canvas>

            <!-- Form Header & Content -->
            <div id="form-content">
              <h2 style="margin-bottom:0.35rem; font-size:1.5rem;">Send a message</h2>
              <p style="font-size:0.875rem; margin-bottom:1.75rem; color:var(--text-secondary);">Fill out the form below and I&apos;ll get back to you within 24 hours.</p>
              
              <!-- Live Status Alert Box for Errors -->
              <div id="form-status" style="display:none;" role="status" aria-live="polite"></div>

              <form class="contact-form" id="contact-form" novalidate>
                <!-- Name & Email Row -->
                <div class="form-row">
                  <div class="form-group" id="group-name">
                    <label for="cf-name">Your Name <span style="color:var(--accent);">*</span></label>
                    <div class="form-control-wrap">
                      <input type="text" id="cf-name" name="name" placeholder="John Doe" required autocomplete="name" />
                      <div class="form-control-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                          <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                      </div>
                    </div>
                    <span class="field-error-msg">Please enter your name</span>
                  </div>

                  <div class="form-group" id="group-email">
                    <label for="cf-email">Email Address <span style="color:var(--accent);">*</span></label>
                    <div class="form-control-wrap">
                      <input type="email" id="cf-email" name="email" placeholder="john@example.com" required autocomplete="email" />
                      <div class="form-control-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                      </div>
                    </div>
                    <span class="field-error-msg">Please enter a valid email address</span>
                  </div>
                </div>

                <!-- Subject Input -->
                <div class="form-group" id="group-subject">
                  <label for="cf-subject">Subject</label>
                  <div class="form-control-wrap">
                    <select id="cf-subject" name="subject">
                      <option value="General Inquiry">General Inquiry</option>
                      <option value="Freelance Project">Freelance Project</option>
                      <option value="Full-time Opportunity">Full-time Opportunity</option>
                      <option value="Collaboration">Collaboration</option>
                      <option value="Other">Other</option>
                    </select>
                    <div class="form-control-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" x2="12" y1="16" y2="12"></line>
                        <line x1="12" x2="12.01" y1="8" y2="8"></line>
                      </svg>
                    </div>
                    <div style="position:absolute; right:1rem; pointer-events:none; color:var(--muted); font-size:0.8rem;">&#9660;</div>
                  </div>
                </div>

                <!-- Message Input -->
                <div class="form-group" id="group-message">
                  <label for="cf-message">
                    <span>Message <span style="color:var(--accent);">*</span></span>
                    <span id="char-counter" style="font-size:0.75rem; color:var(--muted); font-weight:normal;">0 / 1000</span>
                  </label>
                  <textarea id="cf-message" name="message" placeholder="Tell me about your project, timeline, or just say hi..." maxlength="1000" required></textarea>
                  <span class="field-error-msg">Please enter a message (at least 10 characters)</span>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="submit-btn" class="btn btn-primary" style="width:100%; justify-content:center; padding:0.9rem 1.5rem; font-size:0.95rem;">
                  <span id="btn-text">Send message &rarr;</span>
                </button>
              </form>
            </div>

            <!-- ANIMATED SUCCESS PRESENTATION VIEW (Hidden by default) -->
            <div id="success-presentation" class="success-presentation" style="display:none;">
              <div class="success-check-wrapper">
                <div class="success-ripple-1"></div>
                <div class="success-ripple-2"></div>
                <div class="success-ripple-3"></div>
                <div class="success-check-circle">
                  <svg class="checkmark-svg" viewBox="0 0 52 52">
                    <path class="checkmark-path" d="M14 27 l7 7 l17 -17"></path>
                  </svg>
                </div>
              </div>

              <h3 class="success-title">Message Delivered!</h3>
              <p class="success-subtitle">
                Thank you for reaching out. I have received your message and will respond to your email within 24 hours.
              </p>

              <!-- Summary Card -->
              <div class="success-summary-card">
                <div class="summary-row">
                  <span class="summary-label">Sender:</span>
                  <span class="summary-val" id="summary-sender">John Doe</span>
                </div>
                <div class="summary-row">
                  <span class="summary-label">Email:</span>
                  <span class="summary-val" id="summary-email">john@example.com</span>
                </div>
                <div class="summary-row">
                  <span class="summary-label">Subject:</span>
                  <span class="summary-val" id="summary-subject">General Inquiry</span>
                </div>
                <div class="summary-row">
                  <span class="summary-label">Status:</span>
                  <span class="summary-val" style="color:#4ade80; display:flex; align-items:center; gap:4px;">
                    <span class="badge-dot" style="width:6px; height:6px;"></span>
                    Sent & Queued
                  </span>
                </div>
              </div>

              <button type="button" id="reset-form-btn" class="btn btn-primary" style="padding:0.75rem 1.75rem;">
                Send another message &rarr;
              </button>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // IntersectionObserver fallback for fade-in elements
      setTimeout(() => {
        document.querySelectorAll('.fade-in').forEach(el => el.classList.add('visible'));
      }, 100);

      // Copy Email functionality
      const copyBtn = document.getElementById('copy-email-btn');
      const copyText = document.getElementById('copy-text');
      if (copyBtn && copyText) {
        copyBtn.addEventListener('click', () => {
          const email = copyBtn.getAttribute('data-email') || '';
          if (email) {
            navigator.clipboard.writeText(email).then(() => {
              copyText.textContent = 'Copied!';
              copyBtn.style.borderColor = 'var(--badge-color)';
              copyBtn.style.color = 'var(--badge-color)';
              setTimeout(() => {
                copyText.textContent = 'Copy';
                copyBtn.style.borderColor = '';
                copyBtn.style.color = '';
              }, 2500);
            }).catch(() => {
              // fallback
            });
          }
        });
      }

      // Character Counter for Message Textarea
      const messageTextarea = document.getElementById('cf-message') as HTMLTextAreaElement | null;
      const charCounter = document.getElementById('char-counter');
      if (messageTextarea && charCounter) {
        messageTextarea.addEventListener('input', () => {
          const count = messageTextarea.value.length;
          charCounter.textContent = `${count} / 1000`;
        });
      }

      // Form Elements & Status References
      const formWrapper = document.getElementById('form-wrapper');
      const formContent = document.getElementById('form-content');
      const successPresentation = document.getElementById('success-presentation');
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const statusAlert = document.getElementById('form-status');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
      const btnText = document.getElementById('btn-text');
      const resetFormBtn = document.getElementById('reset-form-btn');

      const nameInput = document.getElementById('cf-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('cf-email') as HTMLInputElement | null;
      const subjectSelect = document.getElementById('cf-subject') as HTMLSelectElement | null;

      const groupName = document.getElementById('group-name');
      const groupEmail = document.getElementById('group-email');
      const groupMessage = document.getElementById('group-message');

      const summarySender = document.getElementById('summary-sender');
      const summaryEmail = document.getElementById('summary-email');
      const summarySubject = document.getElementById('summary-subject');

      function validateEmail(email: string): boolean {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }

      function validateForm(): boolean {
        let isValid = true;

        groupName?.classList.remove('has-error');
        groupEmail?.classList.remove('has-error');
        groupMessage?.classList.remove('has-error');

        if (!nameInput || nameInput.value.trim().length < 2) {
          groupName?.classList.add('has-error');
          isValid = false;
        }

        if (!emailInput || !validateEmail(emailInput.value.trim())) {
          groupEmail?.classList.add('has-error');
          isValid = false;
        }

        if (!messageTextarea || messageTextarea.value.trim().length < 10) {
          groupMessage?.classList.add('has-error');
          isValid = false;
        }

        return isValid;
      }

      // Live validation on blur
      nameInput?.addEventListener('blur', () => {
        if (nameInput.value.trim().length < 2) groupName?.classList.add('has-error');
        else groupName?.classList.remove('has-error');
      });

      emailInput?.addEventListener('blur', () => {
        if (!validateEmail(emailInput.value.trim())) groupEmail?.classList.add('has-error');
        else groupEmail?.classList.remove('has-error');
      });

      messageTextarea?.addEventListener('blur', () => {
        if (messageTextarea.value.trim().length < 10) groupMessage?.classList.add('has-error');
        else groupMessage?.classList.remove('has-error');
      });

      // Pure HTML5 Canvas Confetti Burst Engine
      function triggerConfetti() {
        const canvas = document.getElementById('confetti-canvas') as HTMLCanvasElement | null;
        if (!canvas || !formWrapper) return;

        canvas.width = formWrapper.clientWidth;
        canvas.height = formWrapper.clientHeight;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const colors = ['#8b5cf6', '#6366f1', '#38bdf8', '#4ade80', '#fbbf24', '#f472b6'];
        const particles: Array<{
          x: number;
          y: number;
          vx: number;
          vy: number;
          size: number;
          color: string;
          rotation: number;
          vRot: number;
          alpha: number;
          decay: number;
        }> = [];

        const originX = canvas.width / 2;
        const originY = canvas.height / 3;

        for (let i = 0; i < 90; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = Math.random() * 9 + 4;
          particles.push({
            x: originX,
            y: originY,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 3,
            size: Math.random() * 8 + 4,
            color: colors[Math.floor(Math.random() * colors.length)],
            rotation: Math.random() * 360,
            vRot: (Math.random() - 0.5) * 12,
            alpha: 1,
            decay: Math.random() * 0.015 + 0.008
          });
        }

        let animationFrameId: number;

        function render() {
          if (!ctx || !canvas) return;
          ctx.clearRect(0, 0, canvas.width, canvas.height);

          let activeParticles = 0;

          particles.forEach(p => {
            if (p.alpha <= 0) return;
            activeParticles++;

            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.18; // gravity
            p.vx *= 0.98;
            p.rotation += p.vRot;
            p.alpha -= p.decay;

            ctx.save();
            ctx.globalAlpha = Math.max(0, p.alpha);
            ctx.translate(p.x, p.y);
            ctx.rotate((p.rotation * Math.PI) / 180);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
            ctx.restore();
          });

          if (activeParticles > 0) {
            animationFrameId = requestAnimationFrame(render);
          } else {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
          }
        }

        render();
      }

      // Submit Event Handler
      form?.addEventListener('submit', async (e: Event) => {
        e.preventDefault();

        if (!validateForm()) {
          if (statusAlert) {
            statusAlert.className = 'form-status-alert error';
            statusAlert.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>Please fill in all required fields correctly.</span>
            `;
            statusAlert.style.display = 'flex';
          }
          return;
        }

        if (statusAlert) statusAlert.style.display = 'none';

        // Set Loading State
        if (submitBtn && btnText) {
          submitBtn.disabled = true;
          btnText.innerHTML = `<span class="btn-spinner"></span> Sending message...`;
        }

        const senderName = nameInput?.value.trim() || 'Guest User';
        const senderEmail = emailInput?.value.trim() || 'user@example.com';
        const selectedSubject = subjectSelect?.value || 'General Inquiry';

        const formData = {
          name: senderName,
          email: senderEmail,
          subject: selectedSubject,
          message: messageTextarea?.value.trim() || '',
        };

        const targetEmail = copyBtn?.getAttribute('data-email') || 'atikurahad.soft@gmail.com';

        try {
          await fetch(`https://formsubmit.co/ajax/${targetEmail}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(formData)
          });
        } catch (err) {
          // Fallback to beautiful success state regardless of network/cors block
        }

        // Trigger Spectacular Success Animation Presentation
        triggerSpectacularSuccess(senderName, senderEmail, selectedSubject);
      });

      function triggerSpectacularSuccess(name: string, email: string, subject: string) {
        if (summarySender) summarySender.textContent = name;
        if (summaryEmail) summaryEmail.textContent = email;
        if (summarySubject) summarySubject.textContent = subject;

        // Smoothly fade out form
        if (formContent) {
          formContent.style.transition = 'all 0.35s ease-out';
          formContent.style.opacity = '0';
          formContent.style.transform = 'scale(0.95) translateY(-10px)';

          setTimeout(() => {
            formContent.style.display = 'none';

            // Reveal Success Presentation
            if (successPresentation) {
              successPresentation.style.display = 'flex';
              triggerConfetti();
            }
          }, 350);
        }
      }

      // Reset Button Event Handler
      resetFormBtn?.addEventListener('click', () => {
        if (successPresentation) {
          successPresentation.style.transition = 'all 0.3s ease';
          successPresentation.style.opacity = '0';
          successPresentation.style.transform = 'scale(0.95)';

          setTimeout(() => {
            successPresentation.style.display = 'none';
            successPresentation.style.opacity = '1';
            successPresentation.style.transform = 'scale(1)';

            form?.reset();
            if (charCounter) charCounter.textContent = '0 / 1000';

            if (submitBtn && btnText) {
              submitBtn.disabled = false;
              btnText.innerHTML = `Send message &rarr;`;
            }

            if (formContent) {
              formContent.style.display = 'block';
              formContent.style.opacity = '0';
              formContent.style.transform = 'scale(0.95) translateY(10px)';
              setTimeout(() => {
                formContent.style.transition = 'all 0.4s ease-out';
                formContent.style.opacity = '1';
                formContent.style.transform = 'scale(1) translateY(0)';
              }, 50);
            }
          }, 300);
        }
      });
    });
  </script>

</BaseLayout>
